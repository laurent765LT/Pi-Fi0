generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum OrgType {
  INSURER
  BROKER
  ADMIN
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  VIEWER
}

enum OnboardingStatus {
  PENDING
  DOCS_UPLOADED
  VERIFIED
  ACTIVE
  SUSPENDED
}

enum PayoffType {
  AUTOCALL_PHOENIX
  AUTOCALL_COUPON
  CAPITAL_PROTECTED
  CONDITIONAL_RATE
  BARRIER_NOTE
  CUSTOM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  CLOSED
  MATURED
  RECALLED
}

enum ShelfStatus {
  OPEN
  FULL
  CLOSED
  CANCELLED
}

enum CommitmentStatus {
  PENDING
  REVIEW
  CONFIRMED
  WAITING
  CANCELLED
}

// ── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  products         Product[]
  shelves          Shelf[]
  commitments      Commitment[]
  webhooks         Webhook[]
  commissionRules  CommissionRule[]
  insurerRules     InsurerRule[]

  @@map("organizations")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             UserRole         @default(VIEWER)
  orgId            String
  oriasNumber      String?
  oriasValidUntil  DateTime?
  rcpInsurer       String?
  rcpAmount        Float?
  onboardingStatus OnboardingStatus @default(PENDING)
  refreshToken     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization      Organization       @relation(fields: [orgId], references: [id])
  commitments       Commitment[]
  favorites         ProductFavorite[]
  productViews      ProductView[]
  aiRecommendations AiRecommendation[]
  activityLogs      ActivityLog[]

  @@map("users")
}

model Product {
  id                  String        @id @default(cuid())
  isin                String        @unique
  name                String
  payoffType          PayoffType
  issuerName          String
  guarantorName       String?
  underlyingName      String
  underlyingYahoo     String
  initialPrice        Float?
  barrierCapPct       Float
  autocallBarrierPct  Float?
  couponPct           Float?
  maxGainPct          Float
  sri                 Int
  maturityDate        DateTime
  observationDates    DateTime[]
  entryFeePct         Float
  managementFeePct    Float        @default(0)
  reference           String?
  kidUrl              String?
  description         String?
  status              ProductStatus @default(DRAFT)
  orgId               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization      Organization?      @relation(fields: [orgId], references: [id])
  shelves           Shelf[]
  riskMetrics       RiskMetrics?
  commissionRules   CommissionRule[]
  favorites         ProductFavorite[]
  productViews      ProductView[]
  aiRecommendations AiRecommendation[]

  @@index([status])
  @@index([orgId])
  @@map("products")
}

model RiskMetrics {
  id              String   @id @default(cuid())
  productId       String   @unique
  volatility1Y    Float?
  sharpeRatio     Float?
  maxDrawdown     Float?
  mcSimulations   Int?
  mcScenarios     Json?
  calculatedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("risk_metrics")
}

model Shelf {
  id             String      @id @default(cuid())
  productId      String
  orgId          String?
  status         ShelfStatus @default(OPEN)
  targetAmount   Float
  surbookingPct  Float       @default(15)
  closingDate    DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product      Product       @relation(fields: [productId], references: [id])
  organization Organization? @relation(fields: [orgId], references: [id])
  commitments  Commitment[]

  @@map("shelves")
}

model Commitment {
  id        String           @id @default(cuid())
  shelfId   String
  userId    String
  orgId     String?
  amount    Float
  status          CommitmentStatus @default(PENDING)
  rank            Int?
  rejectionReason String?
  reviewedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shelf        Shelf         @relation(fields: [shelfId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [orgId], references: [id])
  commissions  Commission[]

  @@index([userId])
  @@index([shelfId])
  @@map("commitments")
}

model Webhook {
  id        String   @id @default(cuid())
  orgId     String
  url       String
  events    String[]
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("webhooks")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRICING ENGINE & RFQ SIMULATOR
// ═══════════════════════════════════════════════════════════════════════════════

enum StructureType {
  AUTOCALL
  PHOENIX_AUTOCALL
  MEMORY_COUPON
  REVERSE_CONVERTIBLE
  CAPITAL_PROTECTED_NOTE
  CAPPED_PARTICIPATION
  UNCAPPED_PARTICIPATION
  DIGITAL_PAYOFF
  BONUS_CERTIFICATE
  BARRIER_REVERSE_CONVERTIBLE
  CREDIT_LINKED_NOTE
  COUPON_EXPRESS
  DEFENSIVE_INCOME
  CUSTOM
}

enum UnderlyingType {
  SINGLE_STOCK
  INDEX
  ETF
  BASKET_EQUAL
  BASKET_CUSTOM
  BASKET_WORST_OF
  BASKET_BEST_OF
}

enum BarrierMonitoringType {
  EUROPEAN
  CONTINUOUS
  DAILY_CLOSE
}

enum CouponType {
  FIXED
  CONDITIONAL
  MEMORY
  ACCUMULATOR
  NONE
}

enum PricingModel {
  BLACK_SCHOLES
  MONTE_CARLO
  SEMI_ANALYTICAL
  HEURISTIC
}

enum RfqStatus {
  DRAFT
  INTERNALLY_PRICED
  RFQ_SENT
  PARTIALLY_QUOTED
  FULLY_QUOTED
  SELECTED
  APPROVED
  EXPIRED
  CANCELLED
}

enum RfqMode {
  MAX_COUPON_AT_PAR
  BEST_PRICE_FOR_TARGET_COUPON
  STRONGEST_PROTECTION
  ISSUER_COMPETITION
  CLIENT_MANDATE
}

enum QuoteStatus {
  PENDING
  QUOTED
  REJECTED
  EXPIRED
  ACCEPTED
  DECLINED
}

// ── Pricing Run ──────────────────────────────────────────────────────────────

model PricingRun {
  id                String       @id @default(cuid())
  structuredProduct Json         // Full product config snapshot
  modelUsed         PricingModel
  fairValue         Float
  issuePrice        Float
  indicativeCoupon  Float?
  expectedRedemption Float?
  expectedReturn    Float?
  annualizedReturn  Float?
  breakEven         Float?
  maxGain           Float?
  maxLoss           Float?
  scenarioTable     Json?        // Spot scenarios grid
  scenarioGrid      Json?        // Full multi-factor grid
  costBreakdown     Json?        // { structuringMargin, distributionFee, hedgingCost... }
  riskSummary       Json?        // { downsideRisk, probAutocall, probCoupon, probCapitalLoss }
  greeksApprox      Json?        // { delta, gamma, vega, theta, rho }
  payoffChartData   Json?        // Array of {spot, payoff} points
  assumptions       Json?        // Array of strings
  warnings          String[]
  modelLimitations  String[]
  mcPaths           Int?
  mcSeed            Int?
  computeTimeMs     Int?
  createdBy         String?
  createdAt         DateTime     @default(now())

  rfqQuotes RfqQuote[]

  @@map("pricing_runs")
}

// ── Market Data Snapshot ─────────────────────────────────────────────────────

model MarketDataSnapshot {
  id            String   @id @default(cuid())
  ticker        String
  spot          Float
  volatility    Float?
  dividendYield Float?
  riskFreeRate  Float?
  timestamp     DateTime @default(now())

  @@index([ticker, timestamp])
  @@map("market_data_snapshots")
}

// ── Issuer Profile (Simulated) ───────────────────────────────────────────────

model IssuerProfile {
  id                       String   @id @default(cuid())
  name                     String   @unique
  shortName                String
  fundingSpread            Float    @default(0.005)    // 50bps
  volMarkup                Float    @default(0.01)     // 1 vol point
  structuringMargin        Float    @default(0.015)    // 1.5%
  distributionFriendliness Float    @default(0.7)      // 0-1 score
  couponAggressiveness     Float    @default(0.5)      // 0-1
  protectionAggressiveness Float    @default(0.5)      // 0-1
  barrierPreference        Float    @default(60)       // preferred barrier %
  maxMaturityMonths        Int      @default(120)      // 10 years
  minTicket                Float    @default(100000)    // 100k
  supportedStructures      String[]
  unsupportedStructures    String[]
  rejectionProbability     Float    @default(0.1)      // 10%
  quoteDelayMs             Int      @default(2000)     // 2 seconds simulated
  commentStyle             String   @default("neutral") // neutral, aggressive, conservative
  pricingModePreference    String   @default("monte_carlo")
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  rfqQuotes RfqQuote[]

  @@map("issuer_profiles")
}

// ── RFQ Request ──────────────────────────────────────────────────────────────

model RfqRequest {
  id                   String    @id @default(cuid())
  internalRef          String    @unique @default(cuid())
  productConfig        Json      // Full product configuration
  rfqMode              RfqMode   @default(ISSUER_COMPETITION)
  status               RfqStatus @default(DRAFT)
  // Client constraints
  targetCoupon         Float?
  targetIssuePrice     Float?    @default(100)
  targetProtection     Float?
  maxMaturityMonths    Int?
  maxFee               Float?
  targetCurrency       String    @default("EUR")
  preferredUnderlyings String[]
  excludedUnderlyings  String[]
  acceptedIssuers      String[]
  excludedIssuers      String[]
  // Scoring weights
  yieldWeight          Float     @default(0.3)
  protectionWeight     Float     @default(0.25)
  costWeight           Float     @default(0.2)
  qualityWeight        Float     @default(0.15)
  simplicityWeight     Float     @default(0.1)
  // Metadata
  createdBy            String?
  deskName             String?
  clientName           String?
  clientSegment        String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  quotes RfqQuote[]

  @@map("rfq_requests")
}

// ── RFQ Quote ────────────────────────────────────────────────────────────────

model RfqQuote {
  id                   String      @id @default(cuid())
  rfqRequestId         String
  issuerProfileId      String
  pricingRunId         String?
  status               QuoteStatus @default(PENDING)
  // Quote terms
  indicativeCoupon     Float?
  issuePrice           Float?
  couponBarrier        Float?
  autocallBarrier      Float?
  protectionBarrier    Float?
  capitalLevel         Float?
  maturityMonths       Int?
  // Costs
  feesTotal            Float?
  issuerSpread         Float?
  structuringMargin    Float?
  manufacturingFee     Float?
  distributionFee      Float?
  // Scoring
  rankingScore         Float?
  bestExecutionScore   Float?
  yieldScore           Float?
  protectionScore      Float?
  costScore            Float?
  qualityScore         Float?
  simplicityScore      Float?
  // Metadata
  comments             String?
  rejectionReason      String?
  legalDisclaimer      String    @default("SIMULATED QUOTE — This is a synthetic quote generated for educational/analytical purposes. Not a binding offer.")
  validUntil           DateTime?
  quotedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rfqRequest    RfqRequest    @relation(fields: [rfqRequestId], references: [id], onDelete: Cascade)
  issuerProfile IssuerProfile @relation(fields: [issuerProfileId], references: [id])
  pricingRun    PricingRun?   @relation(fields: [pricingRunId], references: [id])

  @@map("rfq_quotes")
}

// ── Saved Templates ──────────────────────────────────────────────────────────

model ProductTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  structureType StructureType
  config        Json     // Full product configuration as template
  isDefault     Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_templates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// COMMISSION ENGINE
// ═══════════════════════════════════════════════════════════════════════════════

enum CommissionType {
  ENTRY_FEE
  MANAGEMENT_FEE
  DISTRIBUTION_FEE
  STRUCTURING_FEE
  TRAILER_FEE
  PERFORMANCE_FEE
}

enum CommissionStatus {
  ACCRUED
  PAYABLE
  PAID
  CANCELLED
}

model CommissionRule {
  id                  String         @id @default(cuid())
  orgId               String?
  productId           String?
  commissionType      CommissionType
  ratePct             Float
  splitPlatformPct    Float          @default(20)
  splitDistributorPct Float          @default(80)
  minAmount           Float?
  maxAmount           Float?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  commissions  Commission[]

  @@map("commission_rules")
}

model Commission {
  id               String           @id @default(cuid())
  commitmentId     String
  ruleId           String
  commissionType   CommissionType
  grossAmount      Float
  platformShare    Float
  distributorShare Float
  status           CommissionStatus @default(ACCRUED)
  paidAt           DateTime?
  invoiceRef       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  commitment Commitment     @relation(fields: [commitmentId], references: [id])
  rule       CommissionRule @relation(fields: [ruleId], references: [id])

  @@index([commitmentId])
  @@index([status])
  @@map("commissions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCT INTEREST & FAVORITES
// ═══════════════════════════════════════════════════════════════════════════════

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_favorites")
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@map("product_views")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INSURER RULES ENGINE
// ═══════════════════════════════════════════════════════════════════════════════

model InsurerRule {
  id                  String   @id @default(cuid())
  orgId               String
  ruleName            String
  allowedPayoffTypes  String[]
  allowedIssuers      String[]
  maxSri              Int?     @default(7)
  minBarrierPct       Float?
  maxMaturityMonths   Int?
  maxEntryFeePct      Float?
  maxManagementFeePct Float?
  minNominal          Float?   @default(1000)
  allowedCurrencies   String[] @default(["EUR"])
  customRules         Json?
  isActive            Boolean  @default(true)
  priority            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("insurer_rules")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AI RECOMMENDATIONS
// ═══════════════════════════════════════════════════════════════════════════════

model AiRecommendation {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  score       Float
  reason      String
  factors     Json
  isViewed    Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, score])
  @@map("ai_recommendations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ACTIVITY LOG
// ═══════════════════════════════════════════════════════════════════════════════

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
