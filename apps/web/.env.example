# ─── Strick'in — apps/web env (Next.js) ─────────────────────────────────────
# Copy to apps/web/.env.local and fill in the values.
# All NEXT_PUBLIC_* values are embedded in the client bundle — never put
# real secrets there.

# ═════════════════════════════════════════════════════════════════════════════
# Feature flags
# ═════════════════════════════════════════════════════════════════════════════

# true → app calls the NestJS backend. false → pure demo mode (localStorage).
NEXT_PUBLIC_USE_REAL_API=false

# Kill-switch for Sentry client/server/edge SDK init. Defaults to true.
FEATURE_SENTRY_ENABLED=true
NEXT_PUBLIC_FEATURE_SENTRY_ENABLED=true

# ═════════════════════════════════════════════════════════════════════════════
# Backend API (NestJS)
# ═════════════════════════════════════════════════════════════════════════════

# Public URL used by the browser to reach the API. In dev, Next.js rewrites
# /api/* → http://localhost:4000/api/* (see next.config.js).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Cookie name under which the access JWT is stored.
NEXT_PUBLIC_AUTH_COOKIE_NAME=strickin_access

# ═════════════════════════════════════════════════════════════════════════════
# Supabase (optional — only if you use the Supabase JS client directly)
# ═════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi…  # anon (public) key

# ═════════════════════════════════════════════════════════════════════════════
# Sentry (frontend)
# ═════════════════════════════════════════════════════════════════════════════
# Public DSN for the "strickin" Sentry project (Web).
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o000000.ingest.sentry.io/000000

# Used at build time by the Sentry webpack plugin to upload source maps.
# Generate at https://sentry.io/settings/strickin/auth-tokens/
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=strickin
SENTRY_PROJECT_WEB=strickin

# ═════════════════════════════════════════════════════════════════════════════
# Build metadata — injected into the bundle so /admin/system-health can show
# which commit is deployed. Set automatically by Vercel via VERCEL_GIT_COMMIT_SHA.
# ═════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_GIT_COMMIT=

# ═════════════════════════════════════════════════════════════════════════════
# Runtime
# ═════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
