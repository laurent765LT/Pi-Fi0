# ─── Strick'in — apps/api env (NestJS) ──────────────────────────────────────
# Copy to apps/api/.env and fill in the values.
# NEVER commit the real file — `.env` is .gitignored.

# ═════════════════════════════════════════════════════════════════════════════
# Runtime
# ═════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=4000
# Valid values: fatal|error|warn|log|debug|verbose (default: log)
LOG_LEVEL=log

# ═════════════════════════════════════════════════════════════════════════════
# PostgreSQL (Supabase)
# ═════════════════════════════════════════════════════════════════════════════
# Pooled connection via pgbouncer — used for runtime queries.
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection — required by Prisma for migrations.
DIRECT_URL=postgresql://postgres.[project-id]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ═════════════════════════════════════════════════════════════════════════════
# Redis (Upstash)
# ═════════════════════════════════════════════════════════════════════════════
# rediss://… for Upstash (TLS). Falls back to an in-memory cache when unset
# or unreachable — see apps/api/src/common/redis.service.ts.
REDIS_URL=rediss://default:[token]@[host]:6379
UPSTASH_REDIS_REST_URL=https://[host]
UPSTASH_REDIS_REST_TOKEN=[token]

# ═════════════════════════════════════════════════════════════════════════════
# JWT authentication
# ═════════════════════════════════════════════════════════════════════════════
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<64 hex chars>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<64 hex chars>
JWT_REFRESH_EXPIRES_IN=30d
# Legacy single-secret fallback — should match JWT_ACCESS_SECRET.
JWT_SECRET=<64 hex chars>

AUTH_COOKIE_NAME=strickin_access

# ═════════════════════════════════════════════════════════════════════════════
# Anthropic Claude API
# ═════════════════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MONTHLY_BUDGET_USD=500
ANTHROPIC_ALERT_THRESHOLD_USD=400

# ═════════════════════════════════════════════════════════════════════════════
# Perplexity (legacy AI provider — kept as fallback while Claude rolls out)
# ═════════════════════════════════════════════════════════════════════════════
PERPLEXITY_API_KEY=pplx-...

# ═════════════════════════════════════════════════════════════════════════════
# Alpha Vantage (market data)
# ═════════════════════════════════════════════════════════════════════════════
ALPHA_VANTAGE_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# Resend (transactional email)
# ═════════════════════════════════════════════════════════════════════════════
RESEND_API_KEY=re_...

# ═════════════════════════════════════════════════════════════════════════════
# Sentry (backend)
# ═════════════════════════════════════════════════════════════════════════════
# Server-only DSN for the "strickin-api" project. Different from the web DSN.
SENTRY_DSN_API=https://xxxx@o000000.ingest.sentry.io/000000
SENTRY_ORG=strickin
SENTRY_PROJECT_API=strickin-api
SENTRY_AUTH_TOKEN=sntrys_...

# Hard kill-switch — set to 'false' to disable Sentry init at boot.
FEATURE_SENTRY_ENABLED=true

# ═════════════════════════════════════════════════════════════════════════════
# Webhooks
# ═════════════════════════════════════════════════════════════════════════════
WEBHOOK_SECRET=change-me-in-production

# ═════════════════════════════════════════════════════════════════════════════
# CORS / misc
# ═════════════════════════════════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:3000,https://strickin-web-web.vercel.app

# Populated by CI (Vercel: VERCEL_GIT_COMMIT_SHA, Railway: RAILWAY_GIT_COMMIT_SHA).
# Surfaced by /ready so operators can verify which commit is live.
GIT_COMMIT=
