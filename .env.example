# ─── Strick'in — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The app works in demo mode without a backend — all fields are optional.

# ── API Backend ───────────────────────────────────────────────────────────────
# URL of the NestJS API. Leave empty for demo mode (frontend-only).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Database (apps/api) ──────────────────────────────────────────────────────
# Supabase pooled connection (via pgbouncer)
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase direct connection (for migrations)
DIRECT_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI / Chat ────────────────────────────────────────────────────────────────
# Perplexity API key for research & chat assistant
PERPLEXITY_API_KEY=pplx-...

# ── Market Data (optional) ────────────────────────────────────────────────────
# Alpha Vantage API key for live quotes
ALPHA_VANTAGE_API_KEY=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend API key for transactional emails & KPI reports
RESEND_API_KEY=re_...

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Web Vitals analytics endpoint
NEXT_PUBLIC_ANALYTICS_URL=

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Secret key for issuer webhook authentication
WEBHOOK_SECRET=change-me-webhook-secret

# ── Deployment ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
